TELEGRAM_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
DATABASE_URL=postgresql://sharof:CHANGEME@localhost:5432/sharof
CONTEXT_MSGS=20
INTERJECT_COOLDOWN_SEC=300
TRIGGER_WORDS=
BOT_USERNAME=

# --- Remote controller (owner only) ---
# Telegram USER ids allowed to use tools (shell on this server + the home PC).
# Empty => no tools at all, ever. Get yours from @userinfobot.
OWNER_IDS=
# Tool calling needs a model that reliably does it. deepseek-chat-v3-0324 called no tool
# in half of a measured run once the chat history contained its own prose answers to PC
# commands; gemini-2.5-flash-lite called it every time, cheaper. Free models: don't.
OPENROUTER_TOOL_MODEL=google/gemini-2.5-flash-lite
# Images (photos you send, pc_look). The same model handles both — it is multimodal.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
# The home PC's miki, published here by its outbound reverse SSH tunnel.
PC_URL=http://127.0.0.1:9099
# Must match MIKI_SECRET in miki's .env on the PC.
PC_SECRET=
# false => no shell anywhere (pc_intent still works). Kill switch.
ALLOW_SHELL=true
