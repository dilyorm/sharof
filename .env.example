TELEGRAM_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
DATABASE_URL=postgresql://sharof:CHANGEME@localhost:5432/sharof
CONTEXT_MSGS=20
INTERJECT_COOLDOWN_SEC=300
TRIGGER_WORDS=
BOT_USERNAME=

# --- Remote controller (owner only) ---
# Telegram USER ids allowed to use tools (shell on this server + the home PC).
# Empty => no tools at all, ever. Get yours from @userinfobot.
OWNER_IDS=
# Tool calling needs a model that actually does it; free models mostly don't.
OPENROUTER_TOOL_MODEL=deepseek/deepseek-chat-v3-0324
# The home PC's miki, published here by its outbound reverse SSH tunnel.
PC_URL=http://127.0.0.1:9099
# Must match MIKI_SECRET in miki's .env on the PC.
PC_SECRET=
# false => no shell anywhere (pc_intent still works). Kill switch.
ALLOW_SHELL=true
